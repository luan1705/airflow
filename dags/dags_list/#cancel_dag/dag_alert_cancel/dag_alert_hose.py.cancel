from airflow import DAG
from airflow.operators.python import PythonOperator, ShortCircuitOperator
from airflow.operators.trigger_dagrun import TriggerDagRunOperator
from datetime import datetime, timedelta, time as dtime
from pendulum import timezone, now
from utils.alert_function import (
    alert_hose1,
    alert_hose2,
    alert_hose3,
    alert_hose4,
    alert_hose5,
    alert_hose6,
    alert_hose7,
    alert_hose8,
    alert_hose9,
    alert_hose10,
)

VN_TZ = timezone("Asia/Ho_Chi_Minh")

default_args = {
    "retries": 10,
    "retry_delay": timedelta(minutes=15),
    "depends_on_past": False,
}

def should_continue() -> bool:
    """
    Chỉ cho phép tiếp tục (tức trigger vòng mới)
    trong khung 09:00–15:00, Thứ 2–Thứ 6 theo giờ VN.
    """
    cur = now(VN_TZ)
    if cur.isoweekday() > 5:  # 1..5 = Mon..Fri
        return False
    t = cur.time()
    return dtime(9, 0) <= t <= dtime(15, 0)

with DAG(
    dag_id="alert_hose",
    default_args=default_args,
    start_date=datetime(2025, 9, 18, tzinfo=VN_TZ),
    schedule="0 9 * * 1-5",  # Tự khởi động 09:00 T2–T6
    catchup=False,
    tags=["alert", "hose"],
    max_active_runs=1,
) as dag:

    # Task chính
    alert_hose1 = PythonOperator(
        task_id="alert_hose1",
        python_callable=alert_hose1,
    )
    alert_hose2  = PythonOperator(
        task_id="alert_hose2",
        python_callable=alert_hose2,
    )
    alert_hose3  = PythonOperator(
        task_id="alert_hose3",
        python_callable=alert_hose3,
    )
    alert_hose4  = PythonOperator(
        task_id="alert_hose4",
        python_callable=alert_hose4,
    )
    alert_hose5  = PythonOperator(
        task_id="alert_hose5",
        python_callable=alert_hose5,
    )
    alert_hose6  = PythonOperator(
        task_id="alert_hose6",
        python_callable=alert_hose6,
    )
    alert_hose7  = PythonOperator(
        task_id="alert_hose7",
        python_callable=alert_hose7,
    )
    alert_hose8  = PythonOperator(
        task_id="alert_hose8",
        python_callable=alert_hose8,
    )
    alert_hose9  = PythonOperator(
        task_id="alert_hose9",
        python_callable=alert_hose9,
    )
    alert_hose10 = PythonOperator(
        task_id="alert_hose10",
        python_callable=alert_hose10,
    )


    # Kiểm tra khung thời gian hợp lệ
    gate_continue = ShortCircuitOperator(
        task_id="in_live_hours",
        python_callable=should_continue,
    )

    # Tự trigger lại chính DAG nếu trong khung giờ
    trigger_next = TriggerDagRunOperator(
        task_id="trigger_next_run",
        trigger_dag_id="alert_hose",
        wait_for_completion=False,
        reset_dag_run=True,
    )

    alerts = [alert_hose1, alert_hose2, alert_hose3, alert_hose4, alert_hose5,
              alert_hose6, alert_hose7, alert_hose8, alert_hose9, alert_hose10]
    alerts >> gate_continue >> trigger_next

